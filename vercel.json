{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.myzerotools.online" }],
      "destination": "https://myzerotools.online/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).(js|css|webp|png|jpg|jpeg|svg|wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
